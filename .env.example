# Black Hawk Security Solution API — environment variables (copy to .env, never commit .env)

# --- Spring profile: dev (local) or prod (VM) ---
SPRING_PROFILES_ACTIVE=prod

# --- Database (PostgreSQL 17) ---
DB_URL=jdbc:postgresql://postgres:5432/blackhawkss
DB_USER=blackhawkss
DB_PASS=
DB_POOL_SIZE=6
# Used by docker-compose for the postgres container itself
POSTGRES_DB=blackhawkss
POSTGRES_USER=blackhawkss
POSTGRES_PASSWORD=

# --- Security ---
# >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=https://blackhawkss.in,https://www.blackhawkss.in

# --- First admin (only used when the admin_users table is empty) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Black Hawk Admin

# --- URLs (used in emails) ---
PUBLIC_BASE_URL=https://blackhawkss.in
ADMIN_BASE_URL=https://blackhawkss.in/admin

# --- Email (SMTP). Resend: smtp.resend.com:465, user "resend", pass = API key.
#     Gmail fallback: smtp.gmail.com:465, user = gmail address, pass = app password.
MAIL_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=Black Hawk Security Solution <leads@blackhawkss.in>
MAIL_OWNER_TO=helloblackhawkss@gmail.com
MAIL_REPLY_TO=helloblackhawkss@gmail.com

# --- Uploads / misc ---
UPLOADS_DIR=/data/uploads
RATE_LIMIT_IP_HOUR=5
RATE_LIMIT_PHONE_DAY=3
REMINDERS_ENABLED=true
DOCS_ENABLED=false

# --- Frontend container (read by docker-compose for the web service) ---
BACKEND_URL=http://api:8080
NEXT_PUBLIC_SITE_URL=https://blackhawkss.in
NEXT_PUBLIC_GA_ID=
